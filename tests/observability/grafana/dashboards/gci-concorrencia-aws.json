{
  "uid": "gci-aws-conc",
  "title": "GCI - Concorrencia no Mesmo Recurso (AWS)",
  "tags": [
    "k6",
    "nfs",
    "concorrencia",
    "aws"
  ],
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Leitura do PDF compartilhado: OK vs falhas (req/s)",
      "description": "Leitores emitem o certificado do mesmo subevento enquanto escritores regravam o mesmo PDF. Falhas http_500 indicam leitura na janela entre apagar e gravar o arquivo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "ok",
          "expr": "sum(rate(k6_conc_file_read_ok_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Leituras OK (req/s)"
        },
        {
          "refId": "falha",
          "expr": "sum by (reason) (rate(k6_conc_file_read_fail_total[$__rate_interval])) > 0",
          "legendFormat": "Falha: {{reason}} (req/s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Leituras OK (req/s)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de falha de leitura do PDF compartilhado (%)",
      "description": "Falhas / (OK + falhas) das leituras do PDF compartilhado. Em execucoes sem escritores (controle) deve ficar em 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "taxa",
          "expr": "100 * sum(rate(k6_conc_file_read_fail_total[$__rate_interval])) / clamp_min(sum(rate(k6_conc_file_read_ok_total[$__rate_interval])) + sum(rate(k6_conc_file_read_fail_total[$__rate_interval])), 0.000001)",
          "legendFormat": "Falha de leitura (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Falha de leitura (%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sessao compartilhada: OK vs falhas (req/s)",
      "description": "Requisicoes simultaneas a user/profile com o mesmo cookie de sessao. Falhas session_lost indicam sessao perdida; http_500, erro do servidor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "ok",
          "expr": "sum(rate(k6_conc_session_ok_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Sessao OK (req/s)"
        },
        {
          "refId": "falha",
          "expr": "sum by (reason) (rate(k6_conc_session_fail_total[$__rate_interval])) > 0",
          "legendFormat": "Falha: {{reason}} (req/s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sessao OK (req/s)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Regravacao do PDF compartilhado: OK vs falhas (req/s)",
      "description": "Escritores regravam (subevento/update) o mesmo PDF e a mesma linha do banco.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "ok",
          "expr": "sum(rate(k6_conc_file_write_ok_total[$__rate_interval])) or vector(0)",
          "legendFormat": "Regravacoes OK (req/s)"
        },
        {
          "refId": "falha",
          "expr": "sum by (reason) (rate(k6_conc_file_write_fail_total[$__rate_interval])) > 0",
          "legendFormat": "Falha: {{reason}} (req/s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Regravacoes OK (req/s)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95: lote de sessao, leitura e regravacao",
      "description": "Lote de sessao = tempo das requisicoes simultaneas ao mesmo cookie (inclui a espera pelo bloqueio do arquivo de sessao). Compare a execucao principal com o controle (SESSION_PARALLEL=1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "lote",
          "expr": "histogram_quantile(0.95, sum(rate(k6_conc_session_batch_ms_seconds[$__rate_interval])))",
          "legendFormat": "p95 lote de sessao"
        },
        {
          "refId": "leitura",
          "expr": "histogram_quantile(0.95, sum(rate(k6_conc_file_read_ms_seconds[$__rate_interval])))",
          "legendFormat": "p95 leitura do PDF"
        },
        {
          "refId": "escrita",
          "expr": "histogram_quantile(0.95, sum(rate(k6_conc_file_write_ms_seconds[$__rate_interval])))",
          "legendFormat": "p95 regravacao do PDF"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Resumo por execucao (acumulado no periodo selecionado)",
      "description": "Totais por run_id dos contadores conc_*. Ajuste o periodo para incluir as execucoes a comparar (principal, drop e controle).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "lok",
          "expr": "sum by (run_id) (max_over_time(k6_conc_file_read_ok_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "lfalha",
          "expr": "sum by (run_id) (max_over_time(k6_conc_file_read_fail_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "lpct",
          "expr": "100 * sum by (run_id) (max_over_time(k6_conc_file_read_fail_total[$__range])) / clamp_min(sum by (run_id) (max_over_time(k6_conc_file_read_ok_total[$__range])) + sum by (run_id) (max_over_time(k6_conc_file_read_fail_total[$__range])), 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "wok",
          "expr": "sum by (run_id) (max_over_time(k6_conc_file_write_ok_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "wfalha",
          "expr": "sum by (run_id) (max_over_time(k6_conc_file_write_fail_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "sok",
          "expr": "sum by (run_id) (max_over_time(k6_conc_session_ok_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "sfalha",
          "expr": "sum by (run_id) (max_over_time(k6_conc_session_fail_total[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "run_id": "Execucao",
              "Value #lok": "Leituras OK",
              "Value #lfalha": "Leituras com falha",
              "Value #lpct": "Falha de leitura (%)",
              "Value #wok": "Regravacoes OK",
              "Value #wfalha": "Regravacoes com falha",
              "Value #sok": "Sessao OK",
              "Value #sfalha": "Sessao com falha"
            },
            "indexByName": {
              "Execucao": 0,
              "Leituras OK": 1,
              "Leituras com falha": 2,
              "Falha de leitura (%)": 3,
              "Regravacoes OK": 4,
              "Regravacoes com falha": 5,
              "Sessao OK": 6,
              "Sessao com falha": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Falha de leitura (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}