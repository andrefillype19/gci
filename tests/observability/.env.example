# Copie para observability/.env (ou rode scripts/sync-aws.ps1, que gera o arquivo).
# O .env NAO e versionado.

# IP publico da EC2 da aplicacao (muda se a instancia for recriada ou reiniciada)
APP_IP=0.0.0.0

# Usuario e chave SSH da EC2 da aplicacao (key_name = key-gci no Terraform)
SSH_USER=ubuntu
SSH_KEY_PATH=C:/Users/SEU_USUARIO/.ssh/key-gci.pem

# IPs privados, alcancados atraves da EC2 da aplicacao (bastion)
DB_IP=10.0.2.153
# Deixe vazio enquanto a EC2 do NFS nao existir
NFS_IP=

# Senha do admin do Grafana
GRAFANA_PASSWORD=admin
