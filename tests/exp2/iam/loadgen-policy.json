{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeituraEMetricas",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:GetMetricData",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmSomenteNoServidorNfs",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:__REGION__::document/AWS-RunShellScript",
        "arn:aws:ec2:__REGION__:__ACCOUNT_ID__:instance/__NFS_ID__"
      ]
    },
    {
      "Sid": "PararPilhaPorTag",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:__REGION__:__ACCOUNT_ID__:instance/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/Project": "GCI" } }
    }
  ]
}
